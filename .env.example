# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/webapp_db?schema=public"

# ── Auth.js v5 ────────────────────────────────────────────────
# Generate your own: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"

# ── GitHub OAuth (optional for local dev) ────────────────────
AUTH_GITHUB_ID="CHANGE_ME"
AUTH_GITHUB_SECRET="CHANGE_ME"

# ── ⚠️ UNSAFE TEMPORARY DEV CREDENTIALS — REMOVE BEFORE PRODUCTION ──
# To find all references: grep -r "UNSAFE\|luxcium_tmp\|pass_UNSAFE" . --include="*.ts" --include="*.env*"
# Files to edit: prisma/seed.ts (delete the luxcium_tmp upsert block)
SEED_ADMIN_EMAIL="luxcium_tmp@local.dev"
SEED_ADMIN_PASSWORD="pass_UNSAFE_tmp"

# ── Prisma telemetry (disable the checkpoint.prisma.io ping) ──
CHECKPOINT_DISABLE=1
